.venv/
.venv-build/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
build/
dist/
renders/
examples/output/
tasks_out/
.DS_Store
# Knowledge-base source PDFs: pinned by sha256 in benchmarks/knowledge/manifest.json, not committed
benchmarks/knowledge/**/raw/
# Probe-run evidence (benchmarks/probe_runs): writeups, rigs, traces and the scored
# documents are tracked; renders (regenerable PNGs), logs and the per-run launch
# shims (absolute paths to one machine) are not
benchmarks/probe_runs/**/renders/
benchmarks/probe_runs/**/*.log
benchmarks/probe_runs/**/server.json
benchmarks/probe_runs/**/mcp.json
benchmarks/probe_runs/**/rd
benchmarks/probe_runs/**/port
benchmarks/probe_runs/**/pid
# Task files the prompt workbook links to: generated by scripts/export_prompts.py
benchmarks/prompts/tasks/
