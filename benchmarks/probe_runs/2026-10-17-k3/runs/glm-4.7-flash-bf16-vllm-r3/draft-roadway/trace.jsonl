{"tool": "annotate_stationing", "kind": "command", "arguments": {"alignment": "ELM-AVE", "interval": 100, "label_offset": -6, "layer": "align_MAIN", "line_point": "[10+00, -6]", "space": "model"}, "ok": false, "error": {"type": "invalid_params", "message": "Additional properties are not allowed ('line_point' was unexpected)", "hint": "params must match the schema; a valid example is included"}, "result": {"ok": false, "name": "annotate_stationing", "error": {"type": "invalid_params", "message": "Additional properties are not allowed ('line_point' was unexpected)", "hint": "params must match the schema; a valid example is included", "valid_params_schema": {"type": "object", "properties": {"space": {"type": "string", "minLength": 1, "description": "'model' (design space, US survey feet) or a sheet id/name (paper space, inches), e.g. 'SH-004' or 'P-201'"}, "path_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "description": "line/polyline/arc entity ids forming the centerline, in order along it (entity-chain mode); with chain=true, any one or more of them"}, "chain": {"type": "boolean", "description": "entity-chain mode: follow the elements joined end to end from path_ids, so one id stations the whole centerline; stops where the linework branches, unless path_ids names the way on"}, "alignment": {"type": "string", "minLength": 1, "description": "design-model alignment name: true stations, equations, and anchored output (alternative to path_ids); a referenced one as 'BASE:ALIGN-1'"}, "lettering": {"enum": ["caltrans", "full"], "description": "alignment mode: 'caltrans' (default) letters the whole station number at each 500 ft and the ones digit elsewhere (85, 6, 7, ... 90); 'full' letters every station 86+00.00"}, "station_side": {"enum": ["below", "above", "left", "right"], "description": "alignment mode: where the station numbers go; default below the line"}, "point_side": {"enum": ["left", "right", "above", "below"], "description": "alignment mode: where the BC/EC and equation lettering goes, square to the line and reading bottom to top; default left"}, "view_rotation": {"type": "number", "description": "alignment mode: the twist (rotation_deg) of the viewport the labels are read through; they are lettered upright on that sheet instead of in the model (default 0, an untwisted view)"}, "point_label_offset": {"type": "number", "exclusiveMinimum": 0, "description": "alignment mode: BC/EC and equation distance from the line (default 22.5 ft, or the annotation scale x 0.45 in)"}, "begin_station": {"type": ["number", "string"], "description": "entity-chain mode: the station (feet, or '15+90.29') at the start of the first element, or at start_point when given"}, "start_point": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2, "description": "entity-chain mode: a point on the path where begin_station is known; stations run on from the end of the path nearer it"}, "reverse": {"type": "boolean", "description": "entity-chain mode: run the stations the other way along the path"}, "station_range": {"type": "array", "items": {"type": ["number", "string"], "description": "display station: feet (8400) or '84+00.00'"}, "minItems": 2, "maxItems": 2, "description": "alignment mode: only annotate between these display stations"}, "include_equations": {"type": "boolean", "description": "alignment mode: label station equations (default true)"}, "interval": {"type": "number", "exclusiveMinimum": 0, "description": "tick spacing in feet (default 100)"}, "tick_half_len": {"type": "number", "exclusiveMinimum": 0, "description": "tick half-length each side of the path (default 3.5 ft, a 7 ft tick at 1\" = 50', or the annotation scale x 0.07 in)"}, "text_height": {"type": "number", "exclusiveMinimum": 0, "description": "label height (default 8 ft, or the annotation scale x 0.10 in)"}, "label_offset": {"type": "number", "description": "station number distance from the path, below it (default 6 ft, or the annotation scale x 0.12 in: half a text height under the tick); negative is the older way of asking for stations on the right, BC/EC left"}, "layer": {"type": "string", "minLength": 1, "description": "layer for ticks; default current"}, "label_layer": {"type": "string", "minLength": 1, "description": "layer for labels; default same as ticks"}, "include_pc_pt": {"type": "boolean", "description": "letter BC/EC/PCC/PRC at the curve points (default true)"}, "connect_tolerance": {"type": "number", "exclusiveMinimum": 0, "description": "max gap between path elements (default 1 ft)"}}, "required": ["space"], "additionalProperties": false}, "example": {"space": "model", "path_ids": ["LN-001", "AR-001"], "begin_station": 8000.0, "interval": 100}}, "warnings": []}}
