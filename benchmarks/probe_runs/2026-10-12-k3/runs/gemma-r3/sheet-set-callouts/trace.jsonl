ditionalProperties": false}, "example": {"space": "model", "target_entity": "DESIGN:LN-004", "at": "mid", "position": [1200.0, 900.0], "content": "EP 12' RT", "layer": "V-ANNO-TEXT"}}, "warnings": []}}
