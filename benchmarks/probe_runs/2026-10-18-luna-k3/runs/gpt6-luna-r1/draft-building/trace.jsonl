en drawing, add the closing course"}, "polyline": {"type": "boolean", "description": "draw one polyline instead of separate lines (straight courses only; with close it is a closed polyline)"}}, "required": ["space", "start", "legs"], "additionalProperties": false}, "example": {"space": "model", "start": [4100.0, 7300.0], "legs": [{"bearing": "S 76°15'00\" E", "distance": 650.0}, {"deflection": "33 L", "distance": 820.0}, "N 71°45'00\" E 540"], "layer": "V-SURV-LINE"}}, "warnings": []}}
