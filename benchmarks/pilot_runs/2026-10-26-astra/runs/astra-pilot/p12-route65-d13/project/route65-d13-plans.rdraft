        "TX-012": {
          "id": "TX-012",
          "type": "text",
          "layer": "0",
          "position": [
            5,
            11
          ],
          "content": "QUANTITY BASIS\nHMA: AA01 / V-ROAD-EP, D13 offsets 40 ft left and right.\nArea = 3,200 ft x 80 ft / 9 = 28,444.44 square yards.\nFence: sum of supplied AA01 / V-ROW linework within station limits.\nV-ROW contains fragmented lines, symbols and overlapping detail;\n2,761.12 ft is a gross layer takeoff, not a verified net fence length.\nVerify continuous fence limits and remove drafting detail before bid use.",
          "height": 0.18,
          "style": "STANDARD",
          "rotation_deg": 0.0,
          "halign": "left",
          "valign": "bottom"
        }
      }
